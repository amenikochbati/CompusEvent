<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/app_bar_simple" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_target"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Découvrir"
                        android:textAppearance="@style/Campus.Text.Overline" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search_round">

                        <EditText
                            android:id="@+id/et_search"
                            style="@style/Campus.SearchField"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:drawableStart="@drawable/ic_search"
                            android:drawablePadding="12dp"
                            android:drawableTint="@color/action_blue_dark"
                            android:hint="Rechercher un événement, un club…"
                            android:inputType="text"
                            android:paddingEnd="44dp" />

                        <ImageButton
                            android:id="@+id/btn_clear_search"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Effacer la recherche"
                            android:src="@drawable/ic_close"
                            android:tint="@color/text_muted"
                            android:visibility="gone" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Catégories"
                            android:textAppearance="@style/Campus.Text.Section" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_filter"
                            style="@style/Campus.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/btn_filter"
                            android:textSize="11sp"
                            app:cornerRadius="19dp"
                            app:icon="@drawable/ic_filter" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cb_show_past"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_categories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_all"
                            style="@style/Campus.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/category_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_tech"
                            style="@style/Campus.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_tech" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_culture"
                            style="@style/Campus.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_culture" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sport"
                            style="@style/Campus.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_sport" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_solidarity"
                            style="@style/Campus.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_solidarity" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_orientation"
                            style="@style/Campus.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_orientation" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_environment"
                            style="@style/Campus.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cat_environment" />

                    </com.google.android.material.chip.ChipGroup>

                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/title_all_events"
                    android:textAppearance="@style/Campus.Text.Section" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_events"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <TextView
                        android:id="@+id/tv_empty_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="24dp"
                        android:text="@string/no_events_found"
                        android:textAppearance="@style/Campus.Text.Body"
                        android:visibility="gone" />

                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="72dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_event"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:backgroundTint="@color/action_blue"
        android:contentDescription="Ajouter un événement"
        android:src="@drawable/ic_plus"
        android:visibility="gone"
        app:tint="@color/white" />

</FrameLayout>
